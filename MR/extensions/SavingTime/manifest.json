{
  "manifest_version": 3,
  "name": "SavingTime",
  "version": "3.1.0",
  "description": "Project operators for text insert and pointer input. Supports all HTML input types.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "SavingTime",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["sidebar-injector.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "click.mp3",
        "mouse.svg",
        "type.mp3",
        "sidepanel.html",
        "sidepanel.css",
        "sidepanel.js"
      ],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ]
}
